{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "env": { "HOST": "127.0.0.1", "PORT": "8000" }
    },
    {
      "name": "2. App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cliente/main.py",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Datos de ejemplo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/seed.py",
      "cwd": "${workspaceFolder}/backend"
    }
  ],
  "compounds": [
    {
      "name": "Backend + App",
      "configurations": ["1. Backend", "2. App"],
      "stopAll": true
    }
  ]
}
